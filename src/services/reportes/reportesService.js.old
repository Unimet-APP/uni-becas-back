  obtenerIconoInsight(tipo) {
    const iconos = {
      success: '✅',
      warning: '⚠️',
      error: '❌',
      info: 'ℹ️'
    };
    return iconos[tipo] || '📌';
  }

  obtenerColorInsight(tipo) {
    const colores = {
      success: 'verde',
      warning: 'amarillo',
      error: 'rojo',
      info: 'azul'
    };
    return colores[tipo] || 'gris';
  }
