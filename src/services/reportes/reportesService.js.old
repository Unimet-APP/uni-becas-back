const pdfGenerator = require('./pdfGenerator');
const chartGenerator = require('./chartGenerator');
const dataAggregator = require('./dataAggregator');
const excelEnhanced = require('./excelEnhanced');
const analytics = require('./analytics');
const ApiError = require('../../utils/ApiError');
const moment = require('moment');
const path = require('path');

class ReportesService {
  /**
   * Reporte 1: Informe Ejecutivo de Período Académico
   * Reporte principal para directivos con vista 360° del programa de becas
   */
  async generarInformeEjecutivo(periodoAcademico = null, formato = 'pdf') {
    try {
      // Recopilar todos los datos necesarios
      const [
        kpis,
        distribucionPostulaciones,
        analisisBeneficiarios,
        analisisAyudantias,
        trendsData,
        insights
      ] = await Promise.all([
        dataAggregator.getKPIs(periodoAcademico),
        dataAggregator.getDistribucionPostulaciones({ periodoAcademico }),
        dataAggregator.getAnalisisBeneficiarios(periodoAcademico),
        dataAggregator.getAnalisisAyudantias(periodoAcademico),
        this.obtenerDatosTendencias(periodoAcademico),
        dataAggregator.generarInsights({}, 'general')
      ]);

      // Generar gráficos
      const graficos = await this.generarGraficosEjecutivo({
        distribucionPostulaciones,
        analisisBeneficiarios,
        analisisAyudantias,
        trendsData
      });

      // Preparar datos para el reporte
      const datosReporte = {
        periodo: periodoAcademico || 'Todos los períodos',
        fechaGeneracion: moment().format('DD [de] MMMM [de] YYYY'),
        kpis,

        // Sección 1: Postulaciones
        postulaciones: {
          total: distribucionPostulaciones.porEstado.reduce((sum, e) => sum + parseInt(e.cantidad), 0),
          porEstado: distribucionPostulaciones.porEstado,
          porTipoBeca: distribucionPostulaciones.porTipoBeca,
          porTipoPostulante: distribucionPostulaciones.porTipoPostulante,
          motivosRechazo: distribucionPostulaciones.motivosRechazo,
          graficos: {
            barrasEstado: graficos.postulacionesPorEstado,
            pastelTipoBeca: graficos.distribucionTipoBeca,
            tendencia30Dias: graficos.tendenciaPostulaciones
          }
        },

        // Sección 2: Beneficiarios
        beneficiarios: {
          ...analisisBeneficiarios,
          graficos: {
            mapaCalor: graficos.mapaCalorBecas,
            distribucionDepartamentos: graficos.distribucionDepartamentos
          }
        },

        // Sección 3: Ayudantías
        ayudantias: analisisAyudantias,

        // Sección 4: Análisis Financiero
        financiero: await this.generarAnalisisFinanciero(periodoAcademico),

        // Sección 5: Insights y Recomendaciones
        insights: this.formatearInsights(insights),

        // Gráficos adicionales
        graficos
      };

      // Generar según formato solicitado
      if (formato === 'pdf') {
        return await pdfGenerator.generatePDF('informe-ejecutivo', datosReporte, {
          title: 'Informe Ejecutivo de Período Académico',
          format: 'A4',
          headerFooter: true
        });
      } else if (formato === 'excel') {
        return await this.generarInformeEjecutivoExcel(datosReporte);
      }

      // Si es JSON, retornar datos crudos
      return datosReporte;
    } catch (error) {
      console.error('Error generando informe ejecutivo:', error);
      throw ApiError.internal('Error al generar informe ejecutivo: ' + error.message);
    }
  }

  /**
   * Reporte 2: Reporte Operativo de Supervisión
   * Para coordinadores y jefes de departamento
   */
  async generarReporteOperativoSupervision(filtros = {}, formato = 'pdf') {
    try {
      const { periodoAcademico, departamento, supervisorId } = filtros;

      // Obtener datos de supervisión
      const whereRiesgo = {};
      if (periodoAcademico) whereRiesgo.periodoInicio = periodoAcademico;

      const [
        supervisoresData,
        cargaTrabajo,
        estudiantesEnRiesgo,
        reportesPendientes,
        plazasAnalisis,
        rendimientoSupervisores
      ] = await Promise.all([
        this.obtenerDatosSupervisores(supervisorId),
        this.analizarCargaTrabajo(supervisorId),
        dataAggregator.identificarEstudiantesEnRiesgoDetallado(whereRiesgo),
        this.obtenerReportesPendientesRevision(supervisorId),
        this.analizarPlazas(departamento, periodoAcademico),
        this.evaluarRendimientoSupervisores(supervisorId, periodoAcademico)
      ]);

      // Generar gráficos operativos
      const graficos = await this.generarGraficosOperativos({
        cargaTrabajo,
        rendimientoSupervisores,
        plazasAnalisis
      });

      const datosReporte = {
        periodo: periodoAcademico || 'Período actual',
        fechaGeneracion: moment().format('DD [de] MMMM [de] YYYY'),

        // Resumen de supervisión
        resumen: {
          totalSupervisores: supervisoresData.length,
          totalAyudantesSupervisionados: cargaTrabajo.totalAyudantes,
          cargaPromedio: cargaTrabajo.promedioAyudantesPorSupervisor,
          alertasSobrecarga: cargaTrabajo.supervisoresSobrecargados
        },

        // Desempeño por supervisor
        supervisores: supervisoresData.map(s => ({
          ...s,
          eficiencia: this.calcularEficienciaSupervisor(s),
          semaforo: this.determinarSemaforoSupervisor(s)
        })),

        // Estudiantes requiriendo atención
        estudiantesEnRiesgo: estudiantesEnRiesgo.map(e => ({
          ...e,
          nivelUrgencia: this.calcularNivelUrgencia(e),
          accionRecomendada: this.generarAccionRecomendada(e)
        })),

        // Reportes pendientes
        reportesPendientes: {
          total: reportesPendientes.length,
          criticos: reportesPendientes.filter(r => r.diasPendiente > 7),
          porSupervisor: this.agruparPorSupervisor(reportesPendientes)
        },

        // Análisis de plazas
        plazas: {
          masProductivas: plazasAnalisis.topProductivas,
          mayorCumplimiento: plazasAnalisis.mejorCumplimiento,
          vacantesVsOcupadas: plazasAnalisis.ocupacion,
          recomendaciones: plazasAnalisis.recomendaciones
        },

        graficos
      };

      // Generar formato solicitado
      if (formato === 'pdf') {
        return await pdfGenerator.generatePDF('operativo-supervision', datosReporte, {
          title: 'Reporte Operativo de Supervisión'
        });
      } else if (formato === 'excel') {
        return await this.generarReporteOperativoExcel(datosReporte);
      }

      return datosReporte;
    } catch (error) {
      console.error('Error generando reporte operativo:', error);
      throw ApiError.internal('Error al generar reporte operativo: ' + error.message);
    }
  }

  /**
   * Reporte 3: Dashboard de Cumplimiento y Rendimiento
   * Vista rápida del estado actual del sistema
   */
  async generarDashboardCumplimiento(filtros = {}, formato = 'pdf') {
    try {
      const { periodoAcademico, actualizacionTiempoReal } = filtros;

      // Métricas en tiempo real
      const [
        metricasActuales,
        alertasActivas,
        tendenciasSemanales,
        topPerformers,
        bottomPerformers,
        estadoSistema
      ] = await Promise.all([
        this.obtenerMetricasRealTime(),
        dataAggregator.getAlertas({ periodoAcademico }),
        this.obtenerTendenciasSemanales(),
        this.obtenerTopPerformers(10),
        this.obtenerBottomPerformers(10),
        this.evaluarEstadoSistema()
      ]);

      // Generar visualizaciones de dashboard
      const visualizaciones = await this.generarVisualizacionesDashboard({
        metricasActuales,
        tendenciasSemanales,
        estadoSistema
      });

      const datosReporte = {
        titulo: 'Dashboard de Cumplimiento y Rendimiento',
        actualizacion: moment().format('DD/MM/YYYY HH:mm:ss'),

        // Widgets principales (KPIs con semáforos)
        widgets: {
          postulacionesEnRevision: {
            valor: metricasActuales.postulaciones.enRevision,
            cambio: metricasActuales.postulaciones.cambioDesdeAyer,
            semaforo: this.calcularSemaforoDashboard(metricasActuales.postulaciones.enRevision, 20, 50)
          },
          beneficiariosActivos: {
            valor: metricasActuales.beneficiarios.activos,
            cambio: 0,
            semaforo: 'verde'
          },
          reportesPendientes: {
            valor: metricasActuales.reportes.pendientes,
            cambio: metricasActuales.reportes.cambioDesdeAyer,
            semaforo: this.calcularSemaforoDashboard(metricasActuales.reportes.pendientes, 10, 30)
          },
          tasaCumplimiento: {
            valor: metricasActuales.cumplimiento.tasaGeneral + '%',
            cambio: metricasActuales.cumplimiento.cambioSemanal,
            semaforo: this.calcularSemaforoMetrica(metricasActuales.cumplimiento.tasaGeneral, 70, 85)
          }
        },

        // Alertas y notificaciones
        alertas: this.priorizarAlertas(alertasActivas),

        // Gráficos de tendencias
        tendencias: {
          ultimos7Dias: tendenciasSemanales,
          graficos: visualizaciones.tendencias
        },

        // Rankings
        rankings: {
          top10: topPerformers,
          bottom10: bottomPerformers,
          requierenApoyo: bottomPerformers.filter(p => p.porcentajeCumplimiento < 50)
        },

        // Estado general del sistema
        estadoSistema: {
          ...estadoSistema,
          salud: this.calcularSaludSistema(estadoSistema),
          recomendacionesRapidas: this.generarRecomendacionesRapidas(estadoSistema)
        },

        visualizaciones
      };

      // Formato de salida
      if (formato === 'pdf') {
        return await pdfGenerator.generatePDF('dashboard-cumplimiento', datosReporte, {
          title: 'Dashboard de Cumplimiento',
          format: 'A4',
          orientation: 'landscape' // Horizontal para mejor visualización
        });
      } else if (formato === 'excel') {
        return await this.generarDashboardExcel(datosReporte);
      }

      return datosReporte;
    } catch (error) {
      console.error('Error generando dashboard:', error);
      throw ApiError.internal('Error al generar dashboard: ' + error.message);
    }
  }

  /**
   * Reporte 4: Análisis Predictivo y Planificación
   * Para planificación estratégica y presupuestaria
   */
  async generarAnalisisPredictivo(filtros = {}, formato = 'pdf') {
    try {
      const { periodosAnalizar = 5, incluirProyecciones = 3 } = filtros;

      // Obtener períodos históricos
      const periodosHistoricos = await this.obtenerPeriodosHistoricos(periodosAnalizar);

      // Análisis predictivo completo
      const analisisPredictivo = await analytics.analyzeAndPredict(
        periodosHistoricos,
        filtros.tipoBeca
      );

      // Análisis presupuestario
      const analisisPresupuestario = await this.generarAnalisisPresupuestario(
        analisisPredictivo.proyecciones,
        periodosHistoricos
      );

      // Análisis de capacidad
      const analisisCapacidad = await this.analizarCapacidadSistema(
        analisisPredictivo.proyecciones,
        analisisPredictivo.historico
      );

      // Generar gráficos predictivos
      const graficos = await this.generarGraficosPredictivos({
        historico: analisisPredictivo.historico,
        proyecciones: analisisPredictivo.proyecciones,
        tendencias: analisisPredictivo.tendencias
      });

      const datosReporte = {
        titulo: 'Análisis Predictivo y Planificación Estratégica',
        fechaGeneracion: moment().format('DD [de] MMMM [de] YYYY'),
        periodosAnalizados: periodosHistoricos,

        // Sección 1: Análisis Histórico
        historico: {
          resumen: this.resumirHistorico(analisisPredictivo.historico),
          tendencias: analisisPredictivo.tendencias,
          estacionalidad: analisisPredictivo.estacionalidad,
          correlaciones: analisisPredictivo.correlaciones,
          graficos: {
            evolucionMetricas: graficos.evolucionHistorica,
            tendenciasLineales: graficos.tendencias
          }
        },

        // Sección 2: Proyecciones
        proyecciones: {
          ...analisisPredictivo.proyecciones,
          graficos: {
            proyeccionPostulaciones: graficos.proyeccionPostulaciones,
            proyeccionBeneficiarios: graficos.proyeccionBeneficiarios,
            intervalosConfianza: graficos.intervalosConfianza
          }
        },

        // Sección 3: Análisis de Eficiencia
        eficiencia: {
          departamentosOptimos: await this.identificarDepartamentosOptimos(),
          supervisoresEficientes: await this.identificarSupervisoresEficientes(),
          plazasEfectivas: await this.identificarPlazasEfectivas(),
          recomendacionesOptimizacion: this.generarRecomendacionesOptimizacion(analisisPredictivo)
        },

        // Sección 4: Análisis Presupuestario
        presupuesto: {
          ...analisisPresupuestario,
          graficos: {
            proyeccionCostos: graficos.proyeccionCostos,
            distribucionPresupuesto: graficos.distribucionPresupuesto
          }
        },

        // Sección 5: Análisis de Capacidad
        capacidad: {
          ...analisisCapacidad,
          recursosRequeridos: this.calcularRecursosRequeridos(analisisPredictivo.proyecciones),
          expansionRecomendada: this.planificarExpansion(analisisCapacidad)
        },

        // Sección 6: Riesgos
        riesgos: analisisPredictivo.riesgos,

        // Sección 7: Recomendaciones Estratégicas
        recomendaciones: {
          inmediatas: analisisPredictivo.recomendaciones.filter(r => r.prioridad === 'critica'),
          cortoPlazo: analisisPredictivo.recomendaciones.filter(r => r.prioridad === 'alta'),
          medianoPlazo: analisisPredictivo.recomendaciones.filter(r => r.prioridad === 'media'),
          estrategicas: this.generarRecomendacionesEstrategicas(analisisPredictivo)
        },

        graficos
      };

      // Formato de salida
      if (formato === 'pdf') {
        return await pdfGenerator.generatePDF('analisis-predictivo', datosReporte, {
          title: 'Análisis Predictivo y Planificación'
        });
      } else if (formato === 'excel') {
        return await this.generarAnalisisPredictivoExcel(datosReporte);
      }

      return datosReporte;
    } catch (error) {
      console.error('Error generando análisis predictivo:', error);
      throw ApiError.internal('Error al generar análisis predictivo: ' + error.message);
    }
  }

  // ========== MÉTODOS AUXILIARES PARA GRÁFICOS ==========

  async generarGraficosEjecutivo(datos) {
    const graficos = await chartGenerator.generateBatchCharts([
      {
        name: 'postulacionesPorEstado',
        type: 'bar',
        data: {
          labels: datos.distribucionPostulaciones.porEstado.map(e => e.estado),
          datasets: [{
            label: 'Postulaciones',
            data: datos.distribucionPostulaciones.porEstado.map(e => e.cantidad)
          }]
        },
        options: {
          title: 'Postulaciones por Estado'
        }
      },
      {
        name: 'distribucionTipoBeca',
        type: 'pie',
        data: {
          labels: datos.distribucionPostulaciones.porTipoBeca.map(t => t.tipoBeca),
          dataset: {
            data: datos.distribucionPostulaciones.porTipoBeca.map(t => t.cantidad)
          }
        },
        options: {
          title: 'Distribución por Tipo de Beca',
          doughnut: true
        }
      },
      {
        name: 'mapaCalorBecas',
        type: 'heatmap',
        data: datos.analisisBeneficiarios.mapaCalor,
        options: {
          title: 'Distribución de Becas por Carrera'
        }
      },
      {
        name: 'distribucionDepartamentos',
        type: 'bar',
        data: {
          labels: Object.keys(datos.analisisAyudantias.porDepartamento || {}),
          datasets: [{
            label: 'Ayudantes por Departamento',
            data: Object.values(datos.analisisAyudantias.porDepartamento || {}).map(d => d.cantidad || 0)
          }]
        },
        options: {
          title: 'Distribución por Departamento',
          horizontal: true
        }
      }
    ]);

    // Convertir array a objeto para fácil acceso
    const graficosObj = {};
    graficos.forEach(g => {
      graficosObj[g.name] = g.image;
    });

    return graficosObj;
  }

  async generarGraficosOperativos(datos) {
    const graficos = await chartGenerator.generateBatchCharts([
      {
        name: 'cargaTrabajo',
        type: 'bar',
        data: {
          labels: datos.cargaTrabajo.supervisores.map(s => s.nombre),
          datasets: [{
            label: 'Ayudantes Asignados',
            data: datos.cargaTrabajo.supervisores.map(s => s.cantidadAyudantes)
          }]
        },
        options: {
          title: 'Carga de Trabajo por Supervisor',
          horizontal: true
        }
      },
      {
        name: 'rendimientoSupervisores',
        type: 'radar',
        data: {
          labels: ['Puntualidad', 'Calidad', 'Respuesta', 'Satisfacción', 'Eficiencia'],
          datasets: datos.rendimientoSupervisores.slice(0, 5).map(s => ({
            label: s.nombre,
            data: [
              s.metricas.puntualidad,
              s.metricas.calidad,
              s.metricas.tiempoRespuesta,
              s.metricas.satisfaccion,
              s.metricas.eficiencia
            ]
          }))
        },
        options: {
          title: 'Comparación de Rendimiento'
        }
      },
      {
        name: 'ocupacionPlazas',
        type: 'progress',
        data: {
          labels: datos.plazasAnalisis.topProductivas.slice(0, 10).map(p => p.nombre),
          values: datos.plazasAnalisis.topProductivas.slice(0, 10).map(p => p.porcentajeOcupacion)
        },
        options: {
          title: 'Ocupación de Plazas Top'
        }
      }
    ]);

    const graficosObj = {};
    graficos.forEach(g => {
      graficosObj[g.name] = g.image;
    });

    return graficosObj;
  }

  async generarVisualizacionesDashboard(datos) {
    const visualizaciones = await chartGenerator.generateBatchCharts([
      {
        name: 'tendenciaPostulaciones',
        type: 'line',
        data: {
          labels: datos.tendenciasSemanales.dias,
          datasets: [{
            label: 'Postulaciones',
            data: datos.tendenciasSemanales.postulaciones
          }]
        },
        options: {
          title: 'Tendencia Últimos 7 Días',
          smooth: true,
          fillArea: true
        }
      },
      {
        name: 'semaforoSistema',
        type: 'gauge',
        value: datos.estadoSistema.saludGeneral,
        options: {
          max: 100,
          title: 'Salud del Sistema',
          label: 'puntos'
        }
      },
      {
        name: 'distribucionAlertas',
        type: 'pie',
        data: {
          labels: ['Críticas', 'Altas', 'Medias', 'Bajas'],
          dataset: {
            data: [
              datos.metricasActuales.alertas.criticas,
              datos.metricasActuales.alertas.altas,
              datos.metricasActuales.alertas.medias,
              datos.metricasActuales.alertas.bajas
            ]
          }
        },
        options: {
          title: 'Distribución de Alertas'
        }
      }
    ]);

    const visualizacionesObj = {};
    visualizaciones.forEach(v => {
      visualizacionesObj[v.name] = v.image;
    });

    return visualizacionesObj;
  }

  async generarGraficosPredictivos(datos) {
    const graficos = await chartGenerator.generateBatchCharts([
      {
        name: 'evolucionHistorica',
        type: 'mixed',
        data: {
          labels: datos.historico.map(h => h.periodo),
          datasets: [
            {
              type: 'bar',
              label: 'Postulaciones',
              data: datos.historico.map(h => h.metricas.postulaciones.total),
              yAxisID: 'y'
            },
            {
              type: 'line',
              label: 'Tasa Aprobación %',
              data: datos.historico.map(h => h.metricas.postulaciones.tasaAprobacion),
              yAxisID: 'y1'
            }
          ]
        },
        options: {
          title: 'Evolución Histórica',
          dualAxis: true
        }
      },
      {
        name: 'proyeccionPostulaciones',
        type: 'line',
        data: {
          labels: [
            ...datos.historico.map(h => h.periodo),
            ...datos.proyecciones.proyeccionBase.map(p => p.periodo)
          ],
          datasets: [
            {
              label: 'Histórico',
              data: [
                ...datos.historico.map(h => h.metricas.postulaciones.total),
                ...Array(datos.proyecciones.proyeccionBase.length).fill(null)
              ]
            },
            {
              label: 'Proyección',
              data: [
                ...Array(datos.historico.length - 1).fill(null),
                datos.historico[datos.historico.length - 1].metricas.postulaciones.total,
                ...datos.proyecciones.proyeccionBase.map(p => p.postulaciones.estimado)
              ]
            }
          ]
        },
        options: {
          title: 'Proyección de Postulaciones'
        }
      }
    ]);

    const graficosObj = {};
    graficos.forEach(g => {
      graficosObj[g.name] = g.image;
    });

    return graficosObj;
  }

  // ========== MÉTODOS DE EXPORTACIÓN A EXCEL ==========

  async generarInformeEjecutivoExcel(datos) {
    return await excelEnhanced.createDashboard({
      metadata: {
        title: 'Informe Ejecutivo de Período Académico',
        subject: 'Análisis completo del programa de becas',
        periodoAcademico: datos.periodo
      },
      includeIndex: true,
      sheets: [
        { name: 'Resumen Ejecutivo', sheetName: 'Resumen', description: 'KPIs y métricas principales' },
        { name: 'Postulaciones', sheetName: 'Postulaciones', description: 'Análisis de postulaciones' },
        { name: 'Beneficiarios', sheetName: 'Beneficiarios', description: 'Listado y análisis de beneficiarios' },
        { name: 'Ayudantías', sheetName: 'Ayudantias', description: 'Análisis del programa de ayudantías' },
        { name: 'Análisis Financiero', sheetName: 'Financiero', description: 'Proyecciones y costos' }
      ],
      resumenEjecutivo: {
        kpis: datos.kpis,
        resumenTabla: this.prepararTablaResumen(datos)
      },
      dataSheets: [
        {
          name: 'Postulaciones',
          data: {
            headers: [
              { label: 'Estado', key: 'estado', type: 'text' },
              { label: 'Cantidad', key: 'cantidad', type: 'number' },
              { label: 'Porcentaje', key: 'porcentaje', type: 'percent' }
            ],
            rows: datos.postulaciones.porEstado.map(e => ({
              estado: e.estado,
              cantidad: e.cantidad,
              porcentaje: e.cantidad / datos.postulaciones.total
            }))
          },
          options: {
            title: 'Distribución de Postulaciones por Estado',
            autoFilter: true,
            freezePanes: true
          }
        },
        {
          name: 'Beneficiarios',
          data: {
            headers: [
              { label: 'Nombre', key: 'nombre', type: 'text', width: 25 },
              { label: 'Email', key: 'email', type: 'text', width: 30 },
              { label: 'Cédula', key: 'cedula', type: 'text', width: 15 },
              { label: 'Tipo Beca', key: 'tipoBeca', type: 'text', width: 20 },
              { label: 'Progreso', key: 'progreso', type: 'percent', width: 15 },
              { label: 'Estado', key: 'estado', type: 'text', width: 15,
                conditional: [
                  { operator: '==', value: 'Activa', backgroundColor: 'FF10B981', fontColor: 'FFFFFFFF' },
                  { operator: '==', value: 'Suspendida', backgroundColor: 'FFF59E0B', fontColor: 'FF000000' },
