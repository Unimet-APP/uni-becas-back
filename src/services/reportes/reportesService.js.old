    };
  }

  calcularSemaforoDashboard(valor, umbralAmarillo, umbralRojo) {
    if (valor <= umbralAmarillo) return 'verde';
    if (valor <= umbralRojo) return 'amarillo';
    return 'rojo';
  }

  calcularSemaforoMetrica(valor, umbralRojo, umbralVerde) {
    if (valor >= umbralVerde) return 'verde';
    if (valor >= umbralRojo) return 'amarillo';
    return 'rojo';
  }

  priorizarAlertas(alertas) {
    // Validar que alertas sea un array válido
    if (!alertas || !Array.isArray(alertas) || alertas.length === 0) {
      return [];
    }

    return alertas
      .sort((a, b) => {
        const prioridad = { critica: 0, alta: 1, media: 2, baja: 3 };
        return prioridad[a.prioridad] - prioridad[b.prioridad];
      })
      .slice(0, 10);
  }

  calcularSaludSistema(estadoSistema) {
    let salud = 100;
    salud -= estadoSistema.componentesCriticos * 20;
    salud -= estadoSistema.componentesConAdvertencia * 5;
    return Math.max(0, salud);
  }

  generarRecomendacionesRapidas(estadoSistema) {
    const recomendaciones = [];
    if (estadoSistema.componentesCriticos > 0) {
      recomendaciones.push('Atender componentes críticos inmediatamente');
    }
    if (estadoSistema.componentesConAdvertencia > 3) {
      recomendaciones.push('Revisar componentes con advertencia');
    }
    return recomendaciones;
  }

  async obtenerPeriodosHistoricos(cantidad) {
    // Generar períodos históricos
    const periodos = [];
    const añoActual = moment().year();
    let año = añoActual;
    let trimestre = parseInt(moment().quarter());

    for (let i = 0; i < cantidad; i++) {
      periodos.unshift(`${año}-${trimestre}`);
      trimestre--;
      if (trimestre < 1) {
        trimestre = 3;
        año--;
      }
    }

    return periodos;
  }

