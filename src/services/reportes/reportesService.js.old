  resumirHistorico(historico) {
    return {
      periodosAnalizados: historico.length,
      promedioPostulaciones: historico.reduce((sum, h) => sum + h.metricas.postulaciones.total, 0) / historico.length,
      promedioBeneficiarios: historico.reduce((sum, h) => sum + h.metricas.beneficiarios.total, 0) / historico.length
    };
  }

