  calcularEficienciaSupervisor(supervisor) {
    const tasaAprobacion = supervisor.reportesRevisados > 0
      ? (supervisor.reportesAprobados / supervisor.reportesRevisados) * 100
      : 0;
    const rapidezRespuesta = Math.max(0, 100 - (supervisor.tiempoPromedioRespuesta * 10));
    return ((tasaAprobacion + rapidezRespuesta + supervisor.tasaSatisfaccion) / 3).toFixed(1);
  }

  determinarSemaforoSupervisor(supervisor) {
    const eficiencia = this.calcularEficienciaSupervisor(supervisor);
    if (eficiencia >= 85) return 'verde';
    if (eficiencia >= 70) return 'amarillo';
    return 'rojo';
  }

  calcularNivelUrgencia(estudiante) {
    if (estudiante.porcentajeCompletado < 30) return 'critico';
    if (estudiante.porcentajeCompletado < 50) return 'alto';
    if (estudiante.porcentajeCompletado < 70) return 'medio';
    return 'bajo';
  }

  generarAccionRecomendada(estudiante) {
    const nivel = this.calcularNivelUrgencia(estudiante);
    switch (nivel) {
      case 'critico':
        return 'Intervención inmediata requerida - Reunión urgente con supervisor';
      case 'alto':
        return 'Programar sesión de apoyo esta semana';
      case 'medio':
        return 'Monitoreo cercano y recordatorio de plazos';
      default:
        return 'Seguimiento regular';
    }
  }

  agruparPorSupervisor(reportes) {
    const agrupados = {};
    reportes.forEach(r => {
      if (!agrupados[r.supervisorId]) {
        agrupados[r.supervisorId] = [];
      }
      agrupados[r.supervisorId].push(r);
    });
    return agrupados;
  }

