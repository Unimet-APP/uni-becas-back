<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Análisis Predictivo y Planificación - {{periodo}}</title>
</head>
<body>
    <!-- PORTADA -->
    <div class="portada">
        <img src="{{logo}}" alt="UNIMET" class="logo">
        <h1>ANÁLISIS PREDICTIVO</h1>
        <h2>Proyecciones y Planificación Estratégica</h2>
        <h2>{{periodo}} - {{periodoProyectado}}</h2>
        <div class="fecha">{{fechaGeneracion}}</div>
    </div>

    <!-- CONTENIDO -->
    <div class="contenido">
        <!-- RESUMEN EJECUTIVO PREDICTIVO -->
        <h1>Resumen Ejecutivo - Proyecciones</h1>

        <div class="kpi-container">
            <div class="kpi-card semaforo-{{semaforoDemanda}}">
                <h4>Demanda Proyectada</h4>
                <div class="valor">{{formatNumber proyecciones.demanda}}</div>
                <div class="cambio {{#if (gt proyecciones.cambioDemanda 0)}}positivo{{else}}negativo{{/if}}">
                    <span class="icono">{{#if (gt proyecciones.cambioDemanda 0)}}↑{{else}}↓{{/if}}</span>
                    <span>{{abs proyecciones.cambioDemanda}}%</span>
                </div>
                <div class="meta">Postulaciones esperadas</div>
            </div>

            <div class="kpi-card semaforo-{{semaforoCumplimiento}}">
                <h4>Tasa de Éxito Esperada</h4>
                <div class="valor">{{proyecciones.tasaExito}}%</div>
                <div class="cambio {{#if (gt proyecciones.cambioTasaExito 0)}}positivo{{else}}negativo{{/if}}">
                    <span class="icono">{{#if (gt proyecciones.cambioTasaExito 0)}}↑{{else}}↓{{/if}}</span>
                    <span>{{abs proyecciones.cambioTasaExito}}%</span>
                </div>
                <div class="meta">Cumplimiento proyectado</div>
            </div>

            <div class="kpi-card semaforo-verde">
                <h4>Confianza del Modelo</h4>
                <div class="valor">{{proyecciones.confianza}}%</div>
                <div class="meta">R² = {{proyecciones.r2}}</div>
            </div>
        </div>

        <!-- SECCIÓN 1: ANÁLISIS DE TENDENCIAS -->
        <div class="seccion page-break">
            <h2>1. Análisis de Tendencias Históricas</h2>

            <div class="subseccion">
                <h3>1.1 Evolución de Indicadores Clave (Últimos 8 Períodos)</h3>

                {{#if graficos.tendenciasHistoricas}}
                <div class="grafico-container">
                    <img src="{{graficos.tendenciasHistoricas}}" alt="Tendencias Históricas">
                    <p class="grafico-titulo">Figura 1: Evolución de métricas clave del programa de becas</p>
                </div>
                {{/if}}

                <table class="tabla-destacada">
                    <thead>
                        <tr>
                            <th>Métrica</th>
                            <th>Media<br>Histórica</th>
                            <th>Último<br>Período</th>
                            <th>Variación</th>
                            <th>Tendencia</th>
                            <th>Estacionalidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each tendencias}}
                        <tr>
                            <td>{{metrica}}</td>
                            <td class="text-center">{{mediaHistorica}}</td>
                            <td class="text-center">{{ultimoPeriodo}}</td>
                            <td class="text-center">
                                <span class="{{#if (gt variacion 0)}}text-success{{else if (lt variacion 0)}}text-danger{{/if}}">
                                    {{#if (gt variacion 0)}}+{{/if}}{{formatDecimal variacion}}%
                                </span>
                            </td>
                            <td class="text-center">
                                {{#if (eq tendencia 'creciente')}}
                                    <span class="badge badge-success">↑ Creciente</span>
                                {{else if (eq tendencia 'decreciente')}}
                                    <span class="badge badge-danger">↓ Decreciente</span>
                                {{else}}
                                    <span class="badge badge-warning">→ Estable</span>
                                {{/if}}
                            </td>
                            <td class="text-center">
                                {{#if estacional}}
                                    <span class="badge badge-info">Sí</span>
                                {{else}}
                                    <span class="badge badge-gray">No</span>
                                {{/if}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <div class="subseccion">
                <h3>1.2 Análisis de Regresión y Correlaciones</h3>

                <div class="graficos-grid">
                    {{#if graficos.regresionLineal}}
                    <div class="grafico-container">
                        <img src="{{graficos.regresionLineal}}" alt="Regresión Lineal">
                        <p class="grafico-titulo">Figura 2: Modelo de regresión lineal - Postulaciones</p>
                    </div>
                    {{/if}}

                    <div>
                        <h4>Factores de Influencia</h4>
                        <table>
                            <thead>
                                <tr>
                                    <th>Factor</th>
                                    <th>Coeficiente</th>
                                    <th>P-Value</th>
                                    <th>Impacto</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each factoresInfluencia}}
                                <tr>
                                    <td>{{factor}}</td>
                                    <td class="text-right">{{formatDecimal coeficiente}}</td>
                                    <td class="text-right">{{formatDecimal pValue}}</td>
                                    <td>
                                        <div class="progress-bar">
                                            <div class="progress-bar-fill {{#if (gt impacto 70)}}success{{else if (gt impacto 40)}}warning{{else}}info{{/if}}"
                                                 style="width: {{impacto}}%">
                                                {{impacto}}%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECCIÓN 2: PROYECCIONES -->
        <div class="seccion page-break">
            <h2>2. Proyecciones para el Próximo Período</h2>

            <div class="subseccion">
                <h3>2.1 Proyección de Demanda por Programa</h3>

                {{#if graficos.proyeccionDemanda}}
                <div class="grafico-container">
                    <img src="{{graficos.proyeccionDemanda}}" alt="Proyección de Demanda">
                    <p class="grafico-titulo">Figura 3: Proyección de postulaciones por programa de beca</p>
                </div>
                {{/if}}

                <table class="tabla-destacada">
                    <thead>
                        <tr>
                            <th>Programa</th>
                            <th>Histórico<br>Promedio</th>
                            <th>Último<br>Período</th>
                            <th>Proyección<br>Próximo</th>
                            <th>Intervalo<br>Confianza (95%)</th>
                            <th>Variación<br>Esperada</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each proyeccionesPorPrograma}}
                        <tr>
                            <td>{{programa}}</td>
                            <td class="text-center">{{historicoPromedio}}</td>
                            <td class="text-center">{{ultimoPeriodo}}</td>
                            <td class="text-center">
                                <strong>{{proyeccion}}</strong>
                            </td>
                            <td class="text-center">[{{intervaloMin}}, {{intervaloMax}}]</td>
                            <td class="text-center">
                                <span class="{{#if (gt variacionEsperada 0)}}text-success{{else if (lt variacionEsperada 0)}}text-danger{{/if}}">
                                    {{#if (gt variacionEsperada 0)}}+{{/if}}{{formatDecimal variacionEsperada}}%
                                </span>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <div class="subseccion">
                <h3>2.2 Escenarios de Proyección</h3>

                <div class="dashboard-grid">
                    <div class="dashboard-widget">
                        <h4>Escenario Optimista</h4>
                        <div class="valor-principal text-success">+{{escenarios.optimista.variacion}}%</div>
                        <div class="tendencia">{{formatNumber escenarios.optimista.postulaciones}} postulaciones</div>
                        <div class="tendencia">Prob: {{escenarios.optimista.probabilidad}}%</div>
                    </div>

                    <div class="dashboard-widget">
                        <h4>Escenario Base</h4>
                        <div class="valor-principal">{{escenarios.base.variacion}}%</div>
                        <div class="tendencia">{{formatNumber escenarios.base.postulaciones}} postulaciones</div>
                        <div class="tendencia">Prob: {{escenarios.base.probabilidad}}%</div>
                    </div>

                    <div class="dashboard-widget">
                        <h4>Escenario Pesimista</h4>
                        <div class="valor-principal text-danger">{{escenarios.pesimista.variacion}}%</div>
                        <div class="tendencia">{{formatNumber escenarios.pesimista.postulaciones}} postulaciones</div>
                        <div class="tendencia">Prob: {{escenarios.pesimista.probabilidad}}%</div>
                    </div>
                </div>

                {{#if graficos.escenarios}}
                <div class="grafico-container">
                    <img src="{{graficos.escenarios}}" alt="Escenarios">
                    <p class="grafico-titulo">Figura 4: Análisis de escenarios con intervalos de confianza</p>
                </div>
                {{/if}}
            </div>

            <div class="subseccion">
                <h3>2.3 Proyección de Recursos Necesarios</h3>

                <table>
                    <thead>
                        <tr>
                            <th>Recurso</th>
                            <th>Actual</th>
                            <th>Proyectado</th>
                            <th>Brecha</th>
                            <th>Recomendación</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each recursosNecesarios}}
                        <tr>
                            <td>{{recurso}}</td>
                            <td class="text-center">{{actual}}</td>
                            <td class="text-center">{{proyectado}}</td>
                            <td class="text-center">
                                <span class="{{#if (gt brecha 0)}}text-danger{{else}}text-success{{/if}}">
                                    {{#if (gt brecha 0)}}+{{/if}}{{brecha}}
                                </span>
                            </td>
                            <td>{{recomendacion}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SECCIÓN 3: ANÁLISIS DE RIESGOS Y OPORTUNIDADES -->
        <div class="seccion page-break">
            <h2>3. Análisis de Riesgos y Oportunidades</h2>

            <div class="subseccion">
                <h3>3.1 Matriz de Riesgos Estratégicos</h3>

                {{#if graficos.matrizRiesgosEstrategicos}}
                <div class="grafico-container">
                    <img src="{{graficos.matrizRiesgosEstrategicos}}" alt="Matriz de Riesgos">
                    <p class="grafico-titulo">Figura 5: Matriz de riesgos estratégicos - Probabilidad vs Impacto</p>
                </div>
                {{/if}}

                <table class="tabla-destacada">
                    <thead>
                        <tr>
                            <th>Riesgo/Oportunidad</th>
                            <th>Tipo</th>
                            <th>Probabilidad</th>
                            <th>Impacto</th>
                            <th>Score</th>
                            <th>Estrategia de Mitigación</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each riesgosOportunidades}}
                        <tr class="{{#if (eq tipo 'riesgo')}}bg-danger-light{{else}}bg-success-light{{/if}}">
                            <td>{{descripcion}}</td>
                            <td>
                                {{#if (eq tipo 'riesgo')}}
                                    <span class="badge badge-danger">Riesgo</span>
                                {{else}}
                                    <span class="badge badge-success">Oportunidad</span>
                                {{/if}}
                            </td>
                            <td class="text-center">{{probabilidad}}%</td>
                            <td class="text-center">
                                <span class="badge badge-{{impactoNivel}}">{{impacto}}</span>
                            </td>
                            <td class="text-center">
                                <strong>{{score}}</strong>
                            </td>
                            <td>{{estrategia}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <div class="subseccion">
                <h3>3.2 Análisis de Sensibilidad</h3>

                {{#if graficos.analisisSensibilidad}}
                <div class="grafico-container">
                    <img src="{{graficos.analisisSensibilidad}}" alt="Análisis de Sensibilidad">
                    <p class="grafico-titulo">Figura 6: Análisis de sensibilidad - Impacto de variables en el resultado</p>
                </div>
                {{/if}}

                <table>
                    <thead>
                        <tr>
                            <th>Variable</th>
                            <th>Valor Base</th>
                            <th>Rango Variación</th>
                            <th>Impacto en<br>Cumplimiento</th>
                            <th>Criticidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each analisisSensibilidad}}
                        <tr>
                            <td>{{variable}}</td>
                            <td class="text-center">{{valorBase}}</td>
                            <td class="text-center">{{rangoVariacion}}</td>
                            <td class="text-center">
                                <span class="{{#if (gt impactoCumplimiento 20)}}text-danger{{else if (gt impactoCumplimiento 10)}}text-warning{{else}}text-success{{/if}}">
                                    {{impactoCumplimiento}}%
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-{{criticidadNivel}}">{{criticidad}}</span>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SECCIÓN 4: PLANIFICACIÓN ESTRATÉGICA -->
        <div class="seccion page-break">
            <h2>4. Planificación Estratégica</h2>

            <div class="subseccion">
                <h3>4.1 Objetivos Estratégicos para el Próximo Período</h3>

                <div class="timeline">
                    {{#each objetivosEstrategicos}}
                    <div class="timeline-item">
                        <div class="timeline-fecha">{{plazo}}</div>
                        <div class="timeline-contenido">
                            <strong>{{objetivo}}</strong>
                            <br>Meta: {{meta}}
                            <br>KPI Principal: {{kpi}}
                            <br>Responsable: {{responsable}}
                            <div class="progress-bar mt-2">
                                <div class="progress-bar-fill {{#if (gte progreso 80)}}success{{else if (gte progreso 50)}}warning{{else}}danger{{/if}}"
                                     style="width: {{progreso}}%">
                                    Preparación: {{progreso}}%
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            <div class="subseccion">
                <h3>4.2 Asignación Óptima de Recursos</h3>

                {{#if graficos.asignacionRecursos}}
                <div class="grafico-container">
                    <img src="{{graficos.asignacionRecursos}}" alt="Asignación de Recursos">
                    <p class="grafico-titulo">Figura 7: Distribución óptima de recursos por programa</p>
                </div>
                {{/if}}

                <table class="tabla-destacada">
                    <thead>
                        <tr>
                            <th>Programa</th>
                            <th>ROI<br>Esperado</th>
                            <th>Justificación</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each asignacionOptima}}
                        <tr>
                            <td>{{programa}}</td>
                            <td class="text-center">{{roiEsperado}}%</td>
                            <td>{{justificacion}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <div class="subseccion">
                <h3>4.3 Plan de Contingencia</h3>

                <table>
                    <thead>
                        <tr>
                            <th>Escenario</th>
                            <th>Probabilidad</th>
                            <th>Trigger</th>
                            <th>Acciones</th>
                            <th>Recursos<br>Necesarios</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each planesContingencia}}
                        <tr>
                            <td>
                                <strong>{{escenario}}</strong>
                            </td>
                            <td class="text-center">{{probabilidad}}%</td>
                            <td>{{trigger}}</td>
                            <td>
                                <ol class="lista-compacta">
                                    {{#each acciones}}
                                    <li>{{this}}</li>
                                    {{/each}}
                                </ol>
                            </td>
                            <td>{{recursosNecesarios}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SECCIÓN 5: SIMULACIÓN MONTE CARLO -->
        <div class="seccion page-break">
            <h2>5. Simulación y Análisis Avanzado</h2>

            <div class="subseccion">
                <h3>5.1 Resultados de Simulación Monte Carlo</h3>

                {{#if graficos.monteCarlo}}
                <div class="grafico-container">
                    <img src="{{graficos.monteCarlo}}" alt="Simulación Monte Carlo">
                    <p class="grafico-titulo">Figura 8: Distribución de resultados - 10,000 simulaciones</p>
                </div>
                {{/if}}

                <div class="dashboard-grid">
                    <div class="dashboard-widget">
                        <h4>Valor Esperado</h4>
                        <div class="valor-principal">{{simulacion.valorEsperado}}</div>
                        <div class="tendencia">Media de simulaciones</div>
                    </div>

                    <div class="dashboard-widget">
                        <h4>Percentil 5</h4>
                        <div class="valor-principal text-danger">{{simulacion.percentil5}}</div>
                        <div class="tendencia">Peor caso (95% confianza)</div>
                    </div>

                    <div class="dashboard-widget">
                        <h4>Percentil 95</h4>
                        <div class="valor-principal text-success">{{simulacion.percentil95}}</div>
                        <div class="tendencia">Mejor caso (95% confianza)</div>
                    </div>

                    <div class="dashboard-widget">
                        <h4>Desviación Estándar</h4>
                        <div class="valor-principal">{{simulacion.desviacion}}</div>
                        <div class="tendencia">Volatilidad esperada</div>
                    </div>
                </div>

                <table>
                    <thead>
                        <tr>
                            <th>Métrica</th>
                            <th>Mínimo</th>
                            <th>P25</th>
                            <th>Mediana</th>
                            <th>P75</th>
                            <th>Máximo</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each metricasSimulacion}}
                        <tr>
                            <td>{{metrica}}</td>
                            <td class="text-center">{{minimo}}</td>
                            <td class="text-center">{{p25}}</td>
                            <td class="text-center"><strong>{{mediana}}</strong></td>
                            <td class="text-center">{{p75}}</td>
                            <td class="text-center">{{maximo}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <div class="subseccion">
                <h3>5.2 Análisis de Capacidad del Sistema</h3>

                {{#if graficos.capacidadSistema}}
                <div class="grafico-container">
                    <img src="{{graficos.capacidadSistema}}" alt="Capacidad del Sistema">
                    <p class="grafico-titulo">Figura 9: Análisis de capacidad y puntos de quiebre</p>
                </div>
                {{/if}}

                <table>
                    <thead>
                        <tr>
                            <th>Componente</th>
                            <th>Capacidad<br>Actual</th>
                            <th>Demanda<br>Proyectada</th>
                            <th>Utilización<br>Esperada</th>
                            <th>Punto de<br>Quiebre</th>
                            <th>Recomendación</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each capacidadSistema}}
                        <tr>
                            <td>{{componente}}</td>
                            <td class="text-center">{{capacidadActual}}</td>
                            <td class="text-center">{{demandaProyectada}}</td>
                            <td class="text-center">
                                <span class="{{#if (gt utilizacion 90)}}text-danger{{else if (gt utilizacion 75)}}text-warning{{else}}text-success{{/if}}">
                                    {{utilizacion}}%
                                </span>
                            </td>
                            <td class="text-center">{{puntoQuiebre}}</td>
                            <td>{{recomendacion}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SECCIÓN 6: RECOMENDACIONES FINALES -->
        <div class="seccion">
            <h2>6. Recomendaciones y Conclusiones</h2>

            <div class="insights">
                <h3>🎯 Recomendaciones Estratégicas Prioritarias</h3>
                <ul>
                    {{#each recomendacionesFinales}}
                    <li>
                        <span class="icono">{{icono}}</span>
                        <div class="contenido">
                            <div class="titulo">{{titulo}}</div>
                            <div class="descripcion">{{descripcion}}</div>
                            <div class="descripcion"><strong>Impacto esperado:</strong> {{impacto}}</div>
                            <div class="descripcion"><strong>Horizonte temporal:</strong> {{horizonte}}</div>
                        </div>
                    </li>
                    {{/each}}
                </ul>
            </div>

            <div class="subseccion">
                <h3>6.1 Indicadores de Seguimiento</h3>

                <table class="tabla-destacada">
                    <thead>
                        <tr>
                            <th>Indicador</th>
                            <th>Frecuencia<br>Medición</th>
                            <th>Meta</th>
                            <th>Umbral<br>Alerta</th>
                            <th>Responsable</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each indicadoresSeguimiento}}
                        <tr>
                            <td>{{indicador}}</td>
                            <td class="text-center">{{frecuencia}}</td>
                            <td class="text-center">{{meta}}</td>
                            <td class="text-center text-warning">{{umbralAlerta}}</td>
                            <td>{{responsable}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <div class="subseccion">
                <h3>6.2 Próximos Pasos</h3>

                <div class="timeline">
                    <h4>Hoja de Ruta - Próximos 3 Meses</h4>

                    {{#each hojaRuta}}
                    <div class="timeline-item">
                        <div class="timeline-fecha">{{fecha}}</div>
                        <div class="timeline-contenido">
                            <strong>{{hito}}</strong>
                            <br>{{descripcion}}
                            <br><small>Entregables: {{entregables}}</small>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            <div class="alerta info mt-4">
                <span class="icono">ℹ️</span>
                <div>
                    <strong>Nota sobre las proyecciones:</strong>
                    Todas las proyecciones están basadas en datos históricos y modelos estadísticos.
                    Los resultados reales pueden variar debido a factores externos no contemplados en el modelo.
                    Se recomienda actualizar las proyecciones mensualmente con datos actualizados.
                </div>
            </div>
        </div>
    </div>

    <!-- PIE DE PÁGINA -->
    <div class="page-footer">
        <p>{{universidad}} - {{sistema}}</p>
        <p>Análisis Predictivo y Planificación Estratégica</p>
        <p>Generado el {{fechaGeneracion}} a las {{horaGeneracion}}</p>
        <p>Documento confidencial - Uso exclusivo para planificación estratégica</p>
    </div>
</body>
</html>